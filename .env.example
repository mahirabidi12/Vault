# Copy to .env and fill in. Never commit .env.

# AI review
# AI_MODE: always = quick look on every package + deep dive when flagged
#          flagged = deep dive only when something is flagged
#          off = no AI
AI_MODE=always
# MODEL_PROVIDER: openai | bedrock
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Reasoning models only: minimal | low | medium | high (low tested: same verdicts, ~2x faster)
OPENAI_REASONING_EFFORT=low
BEDROCK_MODEL_ID=

# Used only for the Claude comparison run
ANTHROPIC_API_KEY=

# AWS
AWS_REGION=
AWS_PROFILE=
