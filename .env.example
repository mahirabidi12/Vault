# Copy to .env and fill in. Never commit .env.

# AI review
# AI_MODE: always = quick look on every package + deep dive when flagged
#          flagged = deep dive only when something is flagged
#          off = no AI
AI_MODE=always
# MODEL_PROVIDER: openai | bedrock
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Reasoning models only: minimal | low | medium | high (low tested: same verdicts, ~2x faster)
OPENAI_REASONING_EFFORT=low
BEDROCK_MODEL_ID=

# Full audit (--full-audit): workers read every chunk of code, the coordinator decides.
# Strong model for both, since workers are the only AI that reads every line.
OPENAI_AUDIT_MODEL=gpt-5.5
OPENAI_AUDIT_REASONING_EFFORT=medium
OPENAI_WORKER_MODEL=gpt-5.5
OPENAI_WORKER_REASONING_EFFORT=medium
AUDIT_WORKER_PARALLEL=4

# Used only for the Claude comparison run
ANTHROPIC_API_KEY=

# AWS
AWS_REGION=
AWS_PROFILE=
