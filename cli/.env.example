# Base URL of the PkgGuard API (no trailing slash).
# Cloud, once deployed:  https://<api-id>.execute-api.<region>.amazonaws.com
# Local dev (no AWS):    http://127.0.0.1:8787   (start with `uv run pkgguard-dev-api` in analyzer/)
PKGGUARD_API_URL=http://127.0.0.1:8787

# Required if the deployed API has API_KEY_SECRET_NAME set (it does by default) - ask the
# scanner agent's operator for the key. Not needed for the local dev API.
PKGGUARD_API_KEY=

# Optional: website base URL, used to print a human-readable report link.
PKGGUARD_WEB_URL=

# How long to poll a scan that hasn't finished yet before giving up.
PKGGUARD_POLL_INTERVAL_MS=1500
PKGGUARD_MAX_WAIT_MS=300000
