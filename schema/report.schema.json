{
  "$defs": {
    "Confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Ecosystem": {
      "enum": [
        "npm"
      ],
      "title": "Ecosystem",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "title": "Ruleid",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/FindingLayer"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "ruleId",
        "layer",
        "severity",
        "confidence",
        "title"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingLayer": {
      "enum": [
        "intel",
        "metadata",
        "static"
      ],
      "title": "FindingLayer",
      "type": "string"
    },
    "PackageRef": {
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "$ref": "#/$defs/Ecosystem"
        },
        "name": {
          "maxLength": 214,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "ecosystem",
        "name",
        "version"
      ],
      "title": "PackageRef",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Full report stored in S3. Intel, metadata and AI sections get typed as those steps are built.",
  "properties": {
    "package": {
      "$ref": "#/$defs/PackageRef"
    },
    "analyzerVersion": {
      "title": "Analyzerversion",
      "type": "string"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "intel": {
      "additionalProperties": true,
      "title": "Intel",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "aiReview": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aireview"
    },
    "humanReview": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Humanreview"
    }
  },
  "required": [
    "package",
    "analyzerVersion",
    "generatedAt"
  ],
  "title": "Report",
  "type": "object"
}
