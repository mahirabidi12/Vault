{
  "$defs": {
    "AIEvidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "file",
        "explanation"
      ],
      "title": "AIEvidence",
      "type": "object"
    },
    "AIReview": {
      "additionalProperties": false,
      "description": "AI verdict plus facts recorded by PkgGuard (never taken from the model's own claims).",
      "properties": {
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "summary": {
          "description": "One or two plain sentences for developers",
          "title": "Summary",
          "type": "string"
        },
        "reasoning": {
          "description": "A few short paragraphs explaining what the code does and why",
          "title": "Reasoning",
          "type": "string"
        },
        "evidence": {
          "description": "Only files and lines you actually read",
          "items": {
            "$ref": "#/$defs/AIEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "findingAssessments": {
          "items": {
            "$ref": "#/$defs/FindingAssessment"
          },
          "title": "Findingassessments",
          "type": "array"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ReviewMode"
        },
        "filesRead": {
          "items": {
            "type": "string"
          },
          "title": "Filesread",
          "type": "array"
        },
        "toolCalls": {
          "default": 0,
          "title": "Toolcalls",
          "type": "integer"
        },
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputtokens"
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputtokens"
        },
        "durationSeconds": {
          "title": "Durationseconds",
          "type": "number"
        }
      },
      "required": [
        "verdict",
        "confidence",
        "summary",
        "reasoning",
        "model",
        "mode",
        "durationSeconds"
      ],
      "title": "AIReview",
      "type": "object"
    },
    "Assessment": {
      "enum": [
        "benign",
        "malicious",
        "uncertain"
      ],
      "title": "Assessment",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Ecosystem": {
      "enum": [
        "npm"
      ],
      "title": "Ecosystem",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "title": "Ruleid",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/FindingLayer"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "installTime": {
          "default": false,
          "title": "Installtime",
          "type": "boolean"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        }
      },
      "required": [
        "ruleId",
        "layer",
        "severity",
        "confidence",
        "title"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingAssessment": {
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "title": "Ruleid",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "ruleId",
        "assessment",
        "explanation"
      ],
      "title": "FindingAssessment",
      "type": "object"
    },
    "FindingLayer": {
      "enum": [
        "intel",
        "metadata",
        "static"
      ],
      "title": "FindingLayer",
      "type": "string"
    },
    "PackageRef": {
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "$ref": "#/$defs/Ecosystem"
        },
        "name": {
          "maxLength": 214,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "ecosystem",
        "name",
        "version"
      ],
      "title": "PackageRef",
      "type": "object"
    },
    "ReviewMode": {
      "enum": [
        "quick_look",
        "deep_dive"
      ],
      "title": "ReviewMode",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "SAFE",
        "SUSPICIOUS",
        "MALICIOUS"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Full report stored in S3. Intel, metadata and code scan sections get typed as those steps settle.",
  "properties": {
    "package": {
      "$ref": "#/$defs/PackageRef"
    },
    "analyzerVersion": {
      "title": "Analyzerversion",
      "type": "string"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "intel": {
      "additionalProperties": true,
      "title": "Intel",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "codeScan": {
      "additionalProperties": true,
      "title": "Codescan",
      "type": "object"
    },
    "aiReview": {
      "anyOf": [
        {
          "$ref": "#/$defs/AIReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "aiError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aierror"
    },
    "humanReview": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Humanreview"
    }
  },
  "required": [
    "package",
    "analyzerVersion",
    "generatedAt"
  ],
  "title": "Report",
  "type": "object"
}
